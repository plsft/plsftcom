---
import Layout from "../layouts/Layout.astro";

type Project = { name: string; url?: string; desc: string };
type ProjectGroup = {
    key: string;
    label: string;
    tagline: string;
    color: string;
    projects: Project[];
};

// Ordered newest-first. Cards without a url render unlinked as "coming soon".
const projectGroups: ProjectGroup[] = [
    {
        key: "trust-security",
        label: "Trust & Security",
        tagline: "Newest — identity, privacy, and provenance",
        color: "#22c55e",
        projects: [
            {
                name: "AuthnzNet",
                url: "https://authnz.net",
                desc: "Developer-first OAuth 2.0 + OpenID Connect server — a full IdentityServer alternative as a single dotnet tool",
            },
            {
                name: "Identizen",
                url: "https://identizen.com",
                desc: "Accountless identity, open core — your phone holds your identity, your biometric unlocks it",
            },
            {
                name: "Pryvc",
                url: "https://pryvc.com",
                desc: "One encrypted profile fills any form in a click, keeps a receipt of what you shared, and revokes on demand",
            },
            {
                name: "Engrave",
                url: "https://tryengrave.com",
                desc: "The black box recorder for AI agents — every tool call, prompt, and decision in a tamper-evident, hash-linked trace",
            },
        ],
    },
    {
        key: "insurtech",
        label: "InsurTech",
        tagline: "Built for insurance agencies",
        color: "#06b6d4",
        projects: [
            {
                name: "CommissionSight",
                url: "https://commissionsight.com",
                desc: "Real-time visibility into sales commissions — track, calculate, and reconcile payouts with confidence",
            },
            {
                name: "Gambase",
                url: "https://gambase.net",
                desc: "AI-powered CRM built for insurance agencies to manage clients and operations",
            },
        ],
    },
    {
        key: "dev-tooling",
        label: "Dev Tooling",
        tagline: "Frameworks, CLIs, and platforms I maintain",
        color: "#f59e0b",
        projects: [
            {
                name: "Worktale",
                url: "https://worktale.org",
                desc: "Productivity and workflow tools for modern teams",
            },
            {
                name: "Facturably",
                url: "https://facturably.com",
                desc: "Developer-first invoicing — track time, invoice, and get paid via Stripe from your terminal, CI, or AI agent",
            },
            {
                name: "Contento",
                url: "https://contento.sh",
                desc: "AI-enabled, CLI-first pSEO platform. Safe, performant, uses an EEAT framework.",
            },
            {
                name: "Rehearse",
                url: "https://rehearse.sh",
                desc: "FAST local and remote GitHub action runner",
            },
            {
                name: "nugx",
                url: "https://nugx.org",
                desc: "A fast, modern browser for the NuGet registry — search, compare, and explore packages keyboard-first",
            },
            {
                name: "Noundry",
                url: "https://noundry.com",
                desc: "Modern C# platform — libraries, tools, and CLI utilities for building and shipping faster",
            },
            {
                name: "NounJS",
                url: "https://nounjs.com",
                desc: "From API to UI in one command — generate admin dashboards from OpenAPI specs",
            },
            {
                name: "Levi",
                url: "https://levi.plsft.com",
                desc: "Edge-native toolkit for building and shipping fast on Cloudflare Workers",
            },
            {
                name: "DotNetMCP",
                url: "https://dotnetmcp.com",
                desc: "MCP server giving AI assistants expert-level .NET performance guidance and legacy-to-modern migration playbooks",
            },
            {
                name: "Chain Prompting",
                url: "https://chainprompting.com",
                desc: "Chain prompting library for C# and .NET — one NuGet package, multi-provider AI gateway with fallback",
            },
        ],
    },
    {
        key: "consumer",
        label: "Consumer",
        tagline: "Apps for everyday life",
        color: "#a855f7",
        projects: [
            {
                name: "Lifetale",
                url: "https://lifetale.io",
                desc: "Your life in 1,000 squares — fill each month with intention",
            },
            {
                name: "Jobably",
                url: "https://jobably.com",
                desc: "The job search that runs itself — scans boards around the clock, scores postings, tailors resumes, tracks your pipeline",
            },
            {
                name: "Moreover",
                url: "https://moreover.dev",
                desc: "Turns emails and messages into project intelligence — capturing claims and surfacing contradictions with what you already know",
            },
        ],
    },
    {
        key: "business",
        label: "Business",
        tagline: "Operations, sales, and growth",
        color: "#71717a",
        projects: [
            {
                name: "Jet",
                url: "https://jet.do",
                desc: "The agentic OS for any business",
            },
            {
                name: "LocalMotion",
                url: "https://localmotion.ai",
                desc: "A real-time research tool built around the bar's competence, confidentiality, and disclosure duties — not against them.",
            },
            {
                name: "Yurn",
                url: "https://yurn.com",
                desc: "Your regulars, one text away — a QR at the counter, one text opts them in, offers land by SMS",
            },
            {
                name: "Bookend",
                url: "https://usebookend.com",
                desc: "Closing validation and loan boarding for community banks — reconciles every term against the credit approval, with an examiner-ready evidence packet",
            },
            {
                name: "LeadKumo",
                url: "https://leadkumo.com",
                desc: "AI-enabled, self-hosted lead distribution cloud for calls and Web leads.",
            },
        ],
    },
];
---

<Layout>
    <!-- Navigation -->
    <nav
        x-data="{ scrolled: false, mobileOpen: false }"
        x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 20 })"
        :class="{ 'bg-[#0a0a0a]/95 backdrop-blur-sm border-b border-[#27272a]': scrolled }"
        class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
    >
        <div
            class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between"
        >
            <a
                href="/"
                class="font-mono text-[#e4e4e7] font-semibold tracking-tight"
            >
                <span class="text-[#22c55e]">~</span>$ plsft/george
            </a>

            <!-- Desktop Nav -->
            <div class="hidden md:flex items-center gap-8">
                <a href="#services" class="nav-link">Services</a>
                <a href="#projects" class="nav-link">Projects</a>
                <a href="#stack" class="nav-link">Stack</a>
                <a href="#about" class="nav-link">About</a>
                <a
                    href="https://cal.com/plurral/30m"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary text-xs py-2 px-4"
                >
                    Book a Call
                </a>
            </div>

            <!-- Mobile Menu Button -->
            <button
                @click="mobileOpen = !mobileOpen"
                class="md:hidden text-[#e4e4e7] hover:text-[#22c55e] transition-colors"
            >
                <svg
                    x-show="!mobileOpen"
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                <svg
                    x-show="mobileOpen"
                    x-cloak
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div
            x-show="mobileOpen"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-2"
            class="md:hidden bg-[#0a0a0a] border-t border-[#27272a]"
        >
            <div class="px-6 py-4 flex flex-col gap-4">
                <a href="#services" @click="mobileOpen = false" class="nav-link"
                    >Services</a
                >
                <a href="#projects" @click="mobileOpen = false" class="nav-link"
                    >Projects</a
                >
                <a href="#stack" @click="mobileOpen = false" class="nav-link"
                    >Stack</a
                >
                <a href="#about" @click="mobileOpen = false" class="nav-link"
                    >About</a
                >
                <a
                    href="https://cal.com/plurral/30m"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary text-center"
                >
                    Book a Call
                </a>
            </div>
        </div>
    </nav>

    <main class="scanlines">
        <!-- Hero Section -->
        <section
            class="min-h-screen flex items-center justify-center px-6 pt-20"
        >
            <div
                class="max-w-4xl w-full"
                x-data="{ typed: '', fullText: '> whoami', roles: ['developer', 'cloud architect', 'tech lead', 'fractional cto', 'applied ai'], showCursor: true }"
                x-init="() => {
        let i = 0;
        const interval = setInterval(() => {
          if (i < fullText.length) {
            typed = fullText.slice(0, i + 1);
            i++;
          } else {
            clearInterval(interval);
            setTimeout(() => { showSubtitle = true; }, 500);
          }
        }, 80);
      }"
            >
                <div class="terminal-window" x-data="{ showSubtitle: false }">
                    <div class="terminal-titlebar">
                        <div class="terminal-dot terminal-dot-red"></div>
                        <div class="terminal-dot terminal-dot-yellow"></div>
                        <div class="terminal-dot terminal-dot-green"></div>
                        <span class="ml-4 text-[#71717a] text-xs font-mono"
                            >george@plsft - bash</span
                        >
                    </div>
                    <div class="terminal-content">
                        <div class="mb-6">
                            <span class="text-[#22c55e] font-mono text-lg"
                                >➜</span
                            >
                            <span class="text-[#06b6d4] font-mono text-lg"
                                >~</span
                            >
                            <span
                                class="text-[#e4e4e7] font-mono text-lg ml-2"
                                x-text="typed"></span>
                            <span
                                x-show="typed.length < '> whoami'.length || typed.length === '> whoami'.length"
                                class="w-[10px] h-[18px] bg-[#22c55e] inline-block ml-[2px] cursor-blink"
                                x-cloak></span>
                        </div>

                        <div
                            x-show="showSubtitle"
                            x-cloak
                            class="space-y-1 mb-6"
                        >
                            <template
                                x-for="(role, index) in roles"
                                :key="index"
                            >
                                <div class="flex items-center gap-2">
                                    <span class="text-[#71717a]">│</span>
                                    <span class="text-[#06b6d4]" x-text="role"
                                    ></span>
                                </div>
                            </template>
                        </div>

                        <div
                            x-show="showSubtitle"
                            x-cloak
                            x-transition:enter="transition ease-out duration-300"
                            x-transition:enter-start="opacity-0 translate-y-2"
                            x-transition:enter-end="opacity-100 translate-y-0"
                            class="space-y-4"
                        >
                            <h1
                                class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#e4e4e7] leading-tight"
                            >
                                I build software<br />
                                <span class="text-[#22c55e] text-glow-green"
                                    >at the edge.</span
                                >
                            </h1>
                            <p
                                class="text-lg text-[#71717a] max-w-xl leading-relaxed"
                            >
                                25 years of enterprise architecture. Deep on
                                the Cloudflare Edge — Workers, D1, R2, Durable
                                Objects — and fluent across the rest of the
                                modern stack. I help teams ship fast and go
                                edge-first.
                            </p>
                            <div class="flex flex-wrap gap-4 pt-4">
                                <a
                                    href="https://cal.com/plurral/30m"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn-primary"
                                >
                                    [ Book a Call ]
                                </a>
                                <a
                                    href="#services"
                                    class="btn-primary bg-transparent border border-[#27272a] hover:border-[#22c55e] hover:bg-transparent"
                                >
                                    [ View Services ]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Scroll indicator -->
                <div
                    class="mt-16 text-center text-[#52525b] font-mono text-sm animate-bounce"
                >
                    <span class="text-[#22c55e]">▼</span> scroll to explore
                </div>
            </div>
        </section>

        <div class="section-divider">
            /* ─────────────────────────────────────────── */
        </div>

        <!-- Services Section -->
        <section id="services" class="py-24 px-6">
            <div class="max-w-6xl mx-auto">
                <div class="mb-12">
                    <span class="text-[#22c55e] font-mono text-sm">// 01</span>
                    <h2
                        class="text-3xl md:text-4xl font-bold text-[#e4e4e7] mt-2"
                    >
                        Services
                    </h2>
                    <p class="text-[#71717a] mt-2">What I can do for you</p>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Service 1: Ship Products -->
                    <div class="terminal-window service-card">
                        <div class="terminal-titlebar">
                            <div class="terminal-dot terminal-dot-red"></div>
                            <div class="terminal-dot terminal-dot-yellow"></div>
                            <div class="terminal-dot terminal-dot-green"></div>
                            <span class="ml-4 text-[#71717a] text-xs font-mono"
                                >ship_product.sh</span
                            >
                        </div>
                        <div class="terminal-content space-y-4">
                            <div class="flex items-center gap-3">
                                <span class="text-[#22c55e] font-mono">></span>
                                <h3
                                    class="text-xl font-semibold text-[#e4e4e7] service-command transition-colors"
                                >
                                    ship_product
                                </h3>
                            </div>
                            <p class="text-[#71717a] text-sm leading-relaxed">
                                Build and launch your product fast. Full-stack
                                development with Cloudflare edge, Levi
                                framework, and Tanstack. I don't just consult —
                                I build <em>with</em> you.
                            </p>
                            <div class="flex flex-wrap gap-2 pt-2">
                                <span class="tech-badge">Levi Framework</span>
                                <span class="tech-badge">Tanstack</span>
                                <span class="tech-badge">Cloudflare</span>
                            </div>
                        </div>
                    </div>

                    <!-- Service 2: Lead Team -->
                    <div class="terminal-window service-card">
                        <div class="terminal-titlebar">
                            <div class="terminal-dot terminal-dot-red"></div>
                            <div class="terminal-dot terminal-dot-yellow"></div>
                            <div class="terminal-dot terminal-dot-green"></div>
                            <span class="ml-4 text-[#71717a] text-xs font-mono"
                                >lead_team.sh</span
                            >
                        </div>
                        <div class="terminal-content space-y-4">
                            <div class="flex items-center gap-3">
                                <span class="text-[#22c55e] font-mono">></span>
                                <h3
                                    class="text-xl font-semibold text-[#e4e4e7] service-command transition-colors"
                                >
                                    lead_team
                                </h3>
                            </div>
                            <p class="text-[#71717a] text-sm leading-relaxed">
                                Fractional tech lead / architect. I join your
                                standups, review PRs, unblock your devs, and
                                make the technical calls you've been deferring.
                            </p>
                            <div class="flex flex-wrap gap-2 pt-2">
                                <span class="tech-badge">PR Reviews</span>
                                <span class="tech-badge">Architecture</span>
                                <span class="tech-badge">Team Leading</span>
                            </div>
                        </div>
                    </div>

                    <!-- Service 3: Cloud Advisory -->
                    <div class="terminal-window service-card">
                        <div class="terminal-titlebar">
                            <div class="terminal-dot terminal-dot-red"></div>
                            <div class="terminal-dot terminal-dot-yellow"></div>
                            <div class="terminal-dot terminal-dot-green"></div>
                            <span class="ml-4 text-[#71717a] text-xs font-mono"
                                >cloud_advisory.sh</span
                            >
                        </div>
                        <div class="terminal-content space-y-4">
                            <div class="flex items-center gap-3">
                                <span class="text-[#22c55e] font-mono">></span>
                                <h3
                                    class="text-xl font-semibold text-[#e4e4e7] service-command transition-colors"
                                >
                                    cloud_advisory
                                </h3>
                            </div>
                            <p class="text-[#71717a] text-sm leading-relaxed">
                                Cloudflare-native architecture. Workers, D1, R2,
                                Durable Objects — designed right from day one,
                                not migrated later. Architecture reviews and
                                migration strategies.
                            </p>
                            <div class="flex flex-wrap gap-2 pt-2">
                                <span class="tech-badge">Workers</span>
                                <span class="tech-badge">D1</span>
                                <span class="tech-badge">R2</span>
                                <span class="tech-badge">Durable Objects</span>
                            </div>
                        </div>
                    </div>

                    <!-- Service 4: Frac CTO -->
                    <div class="terminal-window service-card">
                        <div class="terminal-titlebar">
                            <div class="terminal-dot terminal-dot-red"></div>
                            <div class="terminal-dot terminal-dot-yellow"></div>
                            <div class="terminal-dot terminal-dot-green"></div>
                            <span class="ml-4 text-[#71717a] text-xs font-mono"
                                >frac_cto.sh</span
                            >
                        </div>
                        <div class="terminal-content space-y-4">
                            <div class="flex items-center gap-3">
                                <span class="text-[#22c55e] font-mono">></span>
                                <h3
                                    class="text-xl font-semibold text-[#e4e4e7] service-command transition-colors"
                                >
                                    frac_cto
                                </h3>
                            </div>
                            <p class="text-[#71717a] text-sm leading-relaxed">
                                Your strategic tech partner without the
                                full-time price tag. I align technology with
                                business goals, manage stakeholders, and ensure
                                your team is building the right things.
                            </p>
                            <div class="flex flex-wrap gap-2 pt-2">
                                <span class="tech-badge">Strategy</span>
                                <span class="tech-badge">Leadership</span>
                                <span class="tech-badge">Cloudflare</span>
                                <span class="tech-badge">Architecture</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="section-divider">
            /* ─────────────────────────────────────────── */
        </div>

        <!-- Stack Section -->
        <section id="stack" class="py-24 px-6">
            <div class="max-w-6xl mx-auto">
                <div class="mb-12">
                    <span class="text-[#22c55e] font-mono text-sm">// 02</span>
                    <h2
                        class="text-3xl md:text-4xl font-bold text-[#e4e4e7] mt-2"
                    >
                        Stack
                    </h2>
                    <p class="text-[#71717a] mt-2">My tools of the trade</p>
                </div>

                <div class="terminal-window">
                    <div class="terminal-titlebar">
                        <div class="terminal-dot terminal-dot-red"></div>
                        <div class="terminal-dot terminal-dot-yellow"></div>
                        <div class="terminal-dot terminal-dot-green"></div>
                        <span class="ml-4 text-[#71717a] text-xs font-mono"
                            >stack.config</span
                        >
                    </div>
                    <div class="terminal-content">
                        <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
                            <div class="space-y-3">
                                <h4
                                    class="text-[#22c55e] font-mono text-xs uppercase tracking-wider"
                                >
                                    Cloudflare
                                </h4>
                                <div class="flex flex-wrap gap-2">
                                    <span class="tech-badge">Workers</span>
                                    <span class="tech-badge">D1</span>
                                    <span class="tech-badge">R2</span>
                                    <span class="tech-badge"
                                        >Durable Objects</span
                                    >
                                    <span class="tech-badge">KV</span>
                                    <span class="tech-badge">Vectorize</span>
                                    <span class="tech-badge">Queues</span>
                                    <span class="tech-badge">Pages</span>
                                    <span class="tech-badge">Workers AI</span>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <h4
                                    class="text-[#06b6d4] font-mono text-xs uppercase tracking-wider"
                                >
                                    Frameworks
                                </h4>
                                <div class="flex flex-wrap gap-2">
                                    <span class="tech-badge">Levi</span>
                                    <span class="tech-badge">Tanstack</span>
                                    <span class="tech-badge">Astro</span>
                                    <span class="tech-badge">Hono</span>
                                    <span class="tech-badge">dotnet</span>
                                    <span class="tech-badge">Tauri</span>
                                    <span class="tech-badge">React</span>
                                    <span class="tech-badge">Expo</span>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <h4
                                    class="text-[#f59e0b] font-mono text-xs uppercase tracking-wider"
                                >
                                    Languages
                                </h4>
                                <div class="flex flex-wrap gap-2">
                                    <span class="tech-badge">TypeScript</span>
                                    <span class="tech-badge">C#</span>
                                    <span class="tech-badge">Rust</span>
                                    <span class="tech-badge">SQL</span>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <h4
                                    class="text-[#a855f7] font-mono text-xs uppercase tracking-wider"
                                >
                                    Platforms
                                </h4>
                                <div class="flex flex-wrap gap-2">
                                <span class="tech-badge">Anthropic</span>
                                <span class="tech-badge">OpenAI</span>
                                <span class="tech-badge">Gemini</span>
                                <span class="tech-badge">OpenCode</span>
                                <a
                                        href="https://noundry.com"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="tech-badge hover:border-[#a855f7] hover:text-[#a855f7]"
                                        >Noundry</a
                                    >
                                    
                                </div>
                            </div>
                            <div class="space-y-3">
                                <h4
                                    class="text-[#71717a] font-mono text-xs uppercase tracking-wider"
                                >
                                    Practices
                                </h4>
                                <div class="flex flex-wrap gap-2">
                                    <span class="tech-badge">Edge-First</span>
                                    <span class="tech-badge">SSR</span>
                                    <span class="tech-badge">Type Safety</span>
                                    <span class="tech-badge">Security</span>
                                    <span class="tech-badge">pSEO</span>
                                    <span class="tech-badge">AEO</span>
                                    <span class="tech-badge">GEO</span>
                                    <span class="tech-badge">Applied AI</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="section-divider">
            /* ─────────────────────────────────────────── */
        </div>

        <!-- Projects Section -->
        <section id="projects" class="py-24 px-6">
            <div class="max-w-6xl mx-auto">
                <div class="mb-12">
                    <span class="text-[#22c55e] font-mono text-sm">// 03</span>
                    <h2
                        class="text-3xl md:text-4xl font-bold text-[#e4e4e7] mt-2"
                    >
                        Projects
                    </h2>
                    <p class="text-[#71717a] mt-2">
                        Things I'm building — newest first
                    </p>
                </div>

