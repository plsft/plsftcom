---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navigation -->
  <nav
    x-data="{ scrolled: false, mobileOpen: false }"
    x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 20 })"
    :class="{ 'bg-[#0a0a0a]/95 backdrop-blur-sm border-b border-[#27272a]': scrolled }"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  >
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="font-mono text-[#e4e4e7] font-semibold tracking-tight">
        <span class="text-[#22c55e]">~</span>$ plsft/george
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#services" class="nav-link">Services</a>
        <a href="#products" class="nav-link">Products</a>
        <a href="#stack" class="nav-link">Stack</a>
        <a href="#about" class="nav-link">About</a>
        <a
          href="https://cal.com/plurral/30m"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-xs py-2 px-4"
        >
          Book a Call
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        @click="mobileOpen = !mobileOpen"
        class="md:hidden text-[#e4e4e7] hover:text-[#22c55e] transition-colors"
      >
        <svg x-show="!mobileOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-show="mobileOpen" x-cloak class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      x-show="mobileOpen"
      x-cloak
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-2"
      class="md:hidden bg-[#0a0a0a] border-t border-[#27272a]"
    >
      <div class="px-6 py-4 flex flex-col gap-4">
        <a href="#services" @click="mobileOpen = false" class="nav-link">Services</a>
        <a href="#products" @click="mobileOpen = false" class="nav-link">Products</a>
        <a href="#stack" @click="mobileOpen = false" class="nav-link">Stack</a>
        <a href="#about" @click="mobileOpen = false" class="nav-link">About</a>
        <a
          href="https://cal.com/plurral/30m"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-center"
        >
          Book a Call
        </a>
      </div>
    </div>
  </nav>

  <main class="scanlines">
    <!-- Hero Section -->
    <section class="min-h-screen flex items-center justify-center px-6 pt-20">
      <div class="max-w-4xl w-full" x-data="{ typed: '', fullText: '> whoami', roles: ['developer', 'cloud architect', 'tech lead', 'fractional cto', 'applied ai'], showCursor: true }" x-init="() => {
        let i = 0;
        const interval = setInterval(() => {
          if (i < fullText.length) {
            typed = fullText.slice(0, i + 1);
            i++;
          } else {
            clearInterval(interval);
            setTimeout(() => { showSubtitle = true; }, 500);
          }
        }, 80);
      }">
        <div class="terminal-window" x-data="{ showSubtitle: false }">
          <div class="terminal-titlebar">
            <div class="terminal-dot terminal-dot-red"></div>
            <div class="terminal-dot terminal-dot-yellow"></div>
            <div class="terminal-dot terminal-dot-green"></div>
            <span class="ml-4 text-[#71717a] text-xs font-mono">george@plsft - bash</span>
          </div>
          <div class="terminal-content">
            <div class="mb-6">
              <span class="text-[#22c55e] font-mono text-lg">➜</span>
              <span class="text-[#06b6d4] font-mono text-lg">~</span>
              <span class="text-[#e4e4e7] font-mono text-lg ml-2" x-text="typed"></span>
              <span
                x-show="typed.length < '> whoami'.length || typed.length === '> whoami'.length"
                class="w-[10px] h-[18px] bg-[#22c55e] inline-block ml-[2px] cursor-blink"
                x-cloak
              ></span>
            </div>

            <div x-show="showSubtitle" x-cloak class="space-y-1 mb-6">
              <template x-for="(role, index) in roles" :key="index">
                <div class="flex items-center gap-2">
                  <span class="text-[#71717a]">│</span>
                  <span class="text-[#06b6d4]" x-text="role"></span>
                </div>
              </template>
            </div>

            <div
              x-show="showSubtitle"
              x-cloak
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              class="space-y-4"
            >
              <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#e4e4e7] leading-tight">
                I build software<br />
                <span class="text-[#22c55e] text-glow-green">at the edge.</span>
              </h1>
              <p class="text-lg text-[#71717a] max-w-xl leading-relaxed">
                25 years of enterprise architecture. Now building exclusively on Cloudflare — Workers, D1, R2, Durable Objects. I help teams ship fast and go edge-first.
              </p>
              <div class="flex flex-wrap gap-4 pt-4">
                <a
                  href="https://cal.com/plurral/30m"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary"
                >
                  [ Book a Call ]
                </a>
                <a href="#services" class="btn-primary bg-transparent border border-[#27272a] hover:border-[#22c55e] hover:bg-transparent">
                  [ View Services ]
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Scroll indicator -->
        <div class="mt-16 text-center text-[#52525b] font-mono text-sm animate-bounce">
          <span class="text-[#22c55e]">▼</span> scroll to explore
        </div>
      </div>
    </section>

    <div class="section-divider">/* ─────────────────────────────────────────── */</div>

    <!-- Services Section -->
    <section id="services" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12">
          <span class="text-[#22c55e] font-mono text-sm">// 01</span>
          <h2 class="text-3xl md:text-4xl font-bold text-[#e4e4e7] mt-2">Services</h2>
          <p class="text-[#71717a] mt-2">What I can do for you</p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Service 1: Ship Products -->
          <div class="terminal-window service-card">
            <div class="terminal-titlebar">
              <div class="terminal-dot terminal-dot-red"></div>
              <div class="terminal-dot terminal-dot-yellow"></div>
              <div class="terminal-dot terminal-dot-green"></div>
              <span class="ml-4 text-[#71717a] text-xs font-mono">ship_product.sh</span>
            </div>
            <div class="terminal-content space-y-4">
              <div class="flex items-center gap-3">
                <span class="text-[#22c55e] font-mono">></span>
                <h3 class="text-xl font-semibold text-[#e4e4e7] service-command transition-colors">ship_product</h3>
              </div>
              <p class="text-[#71717a] text-sm leading-relaxed">
                Build and launch your product fast. Full-stack development with Cloudflare edge, Levi framework, and Tanstack. I don't just consult — I build <em>with</em> you.
              </p>
              <div class="flex flex-wrap gap-2 pt-2">
                <span class="tech-badge">Levi Framework</span>
                <span class="tech-badge">Tanstack</span>
                <span class="tech-badge">Cloudflare</span>
              </div>
            </div>
          </div>

          <!-- Service 2: Lead Team -->
          <div class="terminal-window service-card">
            <div class="terminal-titlebar">
              <div class="terminal-dot terminal-dot-red"></div>
              <div class="terminal-dot terminal-dot-yellow"></div>
              <div class="terminal-dot terminal-dot-green"></div>
              <span class="ml-4 text-[#71717a] text-xs font-mono">lead_team.sh</span>
            </div>
            <div class="terminal-content space-y-4">
              <div class="flex items-center gap-3">
                <span class="text-[#22c55e] font-mono">></span>
                <h3 class="text-xl font-semibold text-[#e4e4e7] service-command transition-colors">lead_team</h3>
              </div>
              <p class="text-[#71717a] text-sm leading-relaxed">
                Fractional tech lead / architect. I join your standups, review PRs, unblock your devs, and make the technical calls you've been deferring.
              </p>
              <div class="flex flex-wrap gap-2 pt-2">
                <span class="tech-badge">PR Reviews</span>
                <span class="tech-badge">Architecture</span>
                <span class="tech-badge">Team Leading</span>
              </div>
            </div>
          </div>

          <!-- Service 3: Cloud Advisory -->
          <div class="terminal-window service-card">
            <div class="terminal-titlebar">
              <div class="terminal-dot terminal-dot-red"></div>
              <div class="terminal-dot terminal-dot-yellow"></div>
              <div class="terminal-dot terminal-dot-green"></div>
              <span class="ml-4 text-[#71717a] text-xs font-mono">cloud_advisory.sh</span>
            </div>
            <div class="terminal-content space-y-4">
              <div class="flex items-center gap-3">
                <span class="text-[#22c55e] font-mono">></span>
                <h3 class="text-xl font-semibold text-[#e4e4e7] service-command transition-colors">cloud_advisory</h3>
              </div>
              <p class="text-[#71717a] text-sm leading-relaxed">
                Cloudflare-native architecture. Workers, D1, R2, Durable Objects — designed right from day one, not migrated later. Architecture reviews and migration strategies.
              </p>
              <div class="flex flex-wrap gap-2 pt-2">
                <span class="tech-badge">Workers</span>
                <span class="tech-badge">D1</span>
                <span class="tech-badge">R2</span>
                <span class="tech-badge">Durable Objects</span>
              </div>
            </div>
          </div>

          <!-- Service 4: Frac CTO -->
          <div class="terminal-window service-card">
            <div class="terminal-titlebar">
              <div class="terminal-dot terminal-dot-red"></div>
              <div class="terminal-dot terminal-dot-yellow"></div>
              <div class="terminal-dot terminal-dot-green"></div>
              <span class="ml-4 text-[#71717a] text-xs font-mono">frac_cto.sh</span>
            </div>
            <div class="terminal-content space-y-4">
              <div class="flex items-center gap-3">
                <span class="text-[#22c55e] font-mono">></span>
                <h3 class="text-xl font-semibold text-[#e4e4e7] service-command transition-colors">frac_cto</h3>
              </div>
              <p class="text-[#71717a] text-sm leading-relaxed">
                Your strategic tech partner without the full-time price tag. I align technology with business goals, manage stakeholders, and ensure your team is building the right things.
              </p>
              <div class="flex flex-wrap gap-2 pt-2">
                <span class="tech-badge">Strategy</span>
                <span class="tech-badge">Leadership</span>
                <span class="tech-badge">Cloudflare</span>
                <span class="tech-badge">Architecture</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider">/* ─────────────────────────────────────────── */</div>

    <!-- Stack Section -->
    <section id="stack" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12">
          <span class="text-[#22c55e] font-mono text-sm">// 02</span>
          <h2 class="text-3xl md:text-4xl font-bold text-[#e4e4e7] mt-2">Stack</h2>
          <p class="text-[#71717a] mt-2">My tools of the trade</p>
        </div>

        <div class="terminal-window">
          <div class="terminal-titlebar">
            <div class="terminal-dot terminal-dot-red"></div>
            <div class="terminal-dot terminal-dot-yellow"></div>
            <div class="terminal-dot terminal-dot-green"></div>
            <span class="ml-4 text-[#71717a] text-xs font-mono">stack.config</span>
          </div>
          <div class="terminal-content">
            <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
              <div class="space-y-3">
                <h4 class="text-[#22c55e] font-mono text-xs uppercase tracking-wider">Cloudflare</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="tech-badge">Workers</span>
                  <span class="tech-badge">D1</span>
                  <span class="tech-badge">R2</span>
                  <span class="tech-badge">Durable Objects</span>
                  <span class="tech-badge">KV</span>
                  <span class="tech-badge">Vectorize</span>
                  <span class="tech-badge">Queues</span>
                  <span class="tech-badge">Pages</span>
                  <span class="tech-badge">Workers AI</span>
                </div>
              </div>
              <div class="space-y-3">
                <h4 class="text-[#06b6d4] font-mono text-xs uppercase tracking-wider">Frameworks</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="tech-badge">Levi</span>
                  <span class="tech-badge">Tanstack</span>
                  <span class="tech-badge">Astro</span>
                  <span class="tech-badge">Hono</span>
                  <span class="tech-badge">dotnet</span>
                  <span class="tech-badge">Tauri</span>
                  <span class="tech-badge">React</span>
                  <span class="tech-badge">Expo</span>
                </div>
              </div>
              <div class="space-y-3">
                <h4 class="text-[#f59e0b] font-mono text-xs uppercase tracking-wider">Languages</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="tech-badge">TypeScript</span>
                  <span class="tech-badge">C#</span>
                  <span class="tech-badge">Rust</span>
                  <span class="tech-badge">SQL</span>
                </div>
              </div>
              <div class="space-y-3">
                <h4 class="text-[#a855f7] font-mono text-xs uppercase tracking-wider">Platforms</h4>
                <div class="flex flex-wrap gap-2">
                  <a href="https://noundry.com" target="_blank" rel="noopener noreferrer" class="tech-badge hover:border-[#a855f7] hover:text-[#a855f7]">Noundry</a>
                </div>
              </div>
              <div class="space-y-3">
                <h4 class="text-[#71717a] font-mono text-xs uppercase tracking-wider">Practices</h4>
                <div class="flex flex-wrap gap-2">
                  <span class="tech-badge">Edge-First</span>
                  <span class="tech-badge">SSR</span>
                  <span class="tech-badge">Type Safety</span>
                  <span class="tech-badge">Security</span>
                  <span class="tech-badge">pSEO</span>
                  <span class="tech-badge">AEO</span>
                  <span class="tech-badge">GEO</span>
                  <span class="tech-badge">Applied AI</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider">/* ─────────────────────────────────────────── */</div>

    <!-- Products Section -->
    <section id="products" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12">
          <span class="text-[#22c55e] font-mono text-sm">// 03</span>
          <h2 class="text-3xl md:text-4xl font-bold text-[#e4e4e7] mt-2">Products</h2>
          <p class="text-[#71717a] mt-2">Things I'm building</p>
        </div>

        <div class="terminal-window">
          <div class="terminal-titlebar">
            <div class="terminal-dot terminal-dot-red"></div>
            <div class="terminal-dot terminal-dot-yellow"></div>
            <div class="terminal-dot terminal-dot-green"></div>
            <span class="ml-4 text-[#71717a] text-xs font-mono">products.config</span>
          </div>
          <div class="terminal-content">
            <div class="grid md:grid-cols-2 gap-6">
              <a href="https://worktale.org" target="_blank" rel="noopener noreferrer" class="terminal-window service-card block">
                <div class="terminal-content">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[#22c55e] font-mono">➜</span>
                    <span class="text-[#52525b] text-xs font-mono">worktale.org</span>
                  </div>
                  <h3 class="text-xl font-semibold text-[#e4e4e7] mb-2">Worktale</h3>
                  <p class="text-[#71717a] text-sm">Productivity and workflow tools for modern teams</p>
                </div>
              </a>

              <a href="https://doublespace.io" target="_blank" rel="noopener noreferrer" class="terminal-window service-card block">
                <div class="terminal-content">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[#22c55e] font-mono">➜</span>
                    <span class="text-[#52525b] text-xs font-mono">doublespace.io</span>
                  </div>
                  <h3 class="text-xl font-semibold text-[#e4e4e7] mb-2">DoubleSpace</h3>
                  <p class="text-[#71717a] text-sm">Cloud sync without the cloud bill</p>
                </div>
              </a>

              <a href="https://gitgate.com" target="_blank" rel="noopener noreferrer" class="terminal-window service-card block">
                <div class="terminal-content">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[#22c55e] font-mono">➜</span>
                    <span class="text-[#52525b] text-xs font-mono">gitgate.com</span>
                  </div>
                  <h3 class="text-xl font-semibold text-[#e4e4e7] mb-2">GitGate</h3>
                  <p class="text-[#71717a] text-sm">Edge-native git hosting for the AI era</p>
                </div>
              </a>

              <a href="https://lifetale.io" target="_blank" rel="noopener noreferrer" class="terminal-window service-card block">
                <div class="terminal-content">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[#22c55e] font-mono">➜</span>
                    <span class="text-[#52525b] text-xs font-mono">lifetale.io</span>
                  </div>
                  <h3 class="text-xl font-semibold text-[#e4e4e7] mb-2">LifeTale</h3>
                  <p class="text-[#71717a] text-sm">Life stories, preserved forever</p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider">/* ─────────────────────────────────────────── */</div>

    <!-- About Section -->
    <section id="about" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12">
          <span class="text-[#22c55e] font-mono text-sm">// 04</span>
          <h2 class="text-3xl md:text-4xl font-bold text-[#e4e4e7] mt-2">About</h2>
          <p class="text-[#71717a] mt-2">Who you're working with</p>
        </div>

        <div class="terminal-window">
          <div class="terminal-titlebar">
            <div class="terminal-dot terminal-dot-red"></div>
            <div class="terminal-dot terminal-dot-yellow"></div>
            <div class="terminal-dot terminal-dot-green"></div>
            <span class="ml-4 text-[#71717a] text-xs font-mono">about_george.md</span>
          </div>
          <div class="terminal-content space-y-6">
            <div class="space-y-2">
              <p class="text-[#e4e4e7] leading-relaxed">
                I'm <span class="text-[#22c55e]">George Rios</span> — edge architect and Cloudflare specialist with 25 years of enterprise architecture experience.
              </p>
              <p class="text-[#71717a] leading-relaxed">
                I spent years building complex systems at scale. Now I build exclusively on Cloudflare — helping startups and teams ship production software at the edge, fast.
              </p>
              <p class="text-[#71717a] leading-relaxed">
                Founder of <a href="https://flarefound.com" target="_blank" rel="noopener noreferrer" class="link-terminal">Flarefound</a>, the Cloudflare-only consulting practice. Creator of <a href="https://levi.flarefound.com" target="_blank" rel="noopener noreferrer" class="link-terminal">Levi</a>, an app host framework for Cloudflare Workers.
              </p>
            </div>

            <div class="border-t border-[#27272a] pt-6 space-y-3">
              <div class="flex items-center gap-3">
                <span class="text-[#22c55e] font-mono">$</span>
                <span class="text-[#71717a]">echo $LOCATION</span>
              </div>
              <p class="text-[#e4e4e7] font-mono pl-6">United States</p>

              <div class="flex items-center gap-3">
                <span class="text-[#22c55e] font-mono">$</span>
                <span class="text-[#71717a]">echo $FOCUS</span>
              </div>
              <p class="text-[#e4e4e7] font-mono pl-6">Cloudflare Edge Platform</p>

              <div class="flex items-center gap-3">
                <span class="text-[#22c55e] font-mono">$</span>
                <span class="text-[#71717a]">echo $AVAILABILITY</span>
              </div>
              <p class="text-[#22c55e] font-mono pl-6">● Available for new clients</p>
            </div>

            <div class="pt-4">
              <a
                href="https://cal.com/plurral/30m"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary inline-block"
              >
                [ Book a Call ]
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider">/* ─────────────────────────────────────────── */</div>

    <!-- CTA Section -->
    <section class="py-24 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <div class="terminal-window max-w-2xl mx-auto" x-data="{ show: false }" x-init="() => {
          const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) { show = true; observer.disconnect(); }
          });
          observer.observe($el);
        }">
          <div class="terminal-titlebar">
            <div class="terminal-dot terminal-dot-red"></div>
            <div class="terminal-dot terminal-dot-yellow"></div>
            <div class="terminal-dot terminal-dot-green"></div>
            <span class="ml-4 text-[#71717a] text-xs font-mono">start.sh</span>
          </div>
          <div class="terminal-content py-12 space-y-6">
            <div
              x-show="show"
              x-cloak
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 translate-y-4"
              x-transition:enter-end="opacity-100 translate-y-0"
            >
              <div class="text-[#22c55e] font-mono mb-4">$ ./book_call --duration 30min</div>
              <h2 class="text-3xl md:text-4xl font-bold text-[#e4e4e7]">
                Ready to ship?
              </h2>
              <p class="text-[#71717a] mt-4 max-w-md mx-auto">
                30-minute call. No pitch. Just figuring out if there's a fit and how I can help you ship faster.
              </p>

              <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
                <a
                  href="https://cal.com/plurral/30m"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary text-lg px-8 py-4"
                >
                  [ Book a Call ]
                </a>
                <a
                  href="mailto:george@plsft.com"
                  class="btn-secondary"
