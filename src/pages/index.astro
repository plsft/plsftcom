                                </div>
                            </a>

                            <a
                                href="https://gambase.net"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="terminal-window service-card block"
                            >
                                <div class="terminal-content">
                                    <div
                                        class="flex items-center justify-between mb-2"
                                    >
                                        <span class="text-[#22c55e] font-mono"
                                            >➜</span
                                        >
                                        <span
                                            class="text-[#52525b] text-xs font-mono"
                                            >gambase.net</span
                                        >
                                    </div>
                                    <h3
                                        class="text-xl font-semibold text-[#e4e4e7] mb-2"
                                    >
                                        Gambase
                                    </h3>
                                    <p class="text-[#71717a] text-sm">
                                        AI-powered CRM built for insurance agencies to manage clients and operations
                                    </p>
                                </div>
                            </a>

                            <a
                                href="https://moreover.dev"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="terminal-window service-card block"
                            >
                                <div class="terminal-content">
                                    <div
                                        class="flex items-center justify-between mb-2"
                                    >
                                        <span class="text-[#22c55e] font-mono"
                                            >➜</span
                                        >
                                        <span
                                            class="text-[#52525b] text-xs font-mono"
                                            >moreover.dev</span
                                        >
                                    </div>
                                    <h3
                                        class="text-xl font-semibold text-[#e4e4e7] mb-2"
                                    >
                                        Moreover
                                    </h3>
                                    <p class="text-[#71717a] text-sm">
                                        Turns emails and messages into project intelligence — capturing claims and surfacing contradictions with what you already know
                                    </p>
                                </div>
                            </a>

                            <a
                                href="https://leadkumo.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="terminal-window service-card block"
                            >
                                <div class="terminal-content">
                                    <div
                                        class="flex items-center justify-between mb-2"
                                    >
